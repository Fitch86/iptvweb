#!/bin/sh
# Allow the long-lived IPTV CGI to exceed uhttpd's default 60s timeout.
if command -v uci >/dev/null 2>&1; then
    uci -q set uhttpd.main.script_timeout='86400' || true
    uci -q commit uhttpd || true
fi

# Fetch the full mpegts.js distribution once at install/first boot time.
# Runtime playback is local and does not contact jsDelivr/unpkg.
mkdir -p /www/luci-static/resources/iptvweb /tmp
TARGET=/www/luci-static/resources/iptvweb/mpegts.min.js
TMP=/tmp/mpegts.min.js.iptvweb
URL1='https://cdn.jsdelivr.net/npm/mpegts.js@1.8.0/dist/mpegts.min.js'
URL2='https://unpkg.com/mpegts.js@1.8.0/dist/mpegts.min.js'
fetch_ok=0
if command -v uclient-fetch >/dev/null 2>&1; then
    uclient-fetch -q -O "$TMP" "$URL1" 2>/dev/null && fetch_ok=1 || true
    if [ "$fetch_ok" = 0 ]; then
        uclient-fetch -q -O "$TMP" "$URL2" 2>/dev/null && fetch_ok=1 || true
    fi
elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$TMP" "$URL1" && fetch_ok=1 || true
    if [ "$fetch_ok" = 0 ]; then
        wget -q -O "$TMP" "$URL2" && fetch_ok=1 || true
    fi
fi
if [ "$fetch_ok" = 1 ] && [ -s "$TMP" ] && [ "$(wc -c < "$TMP")" -gt 100000 ] && grep -q 'mpegts' "$TMP" 2>/dev/null; then
    mv -f "$TMP" "$TARGET"
    chmod 0644 "$TARGET"
else
    rm -f "$TMP"
    echo "iptvweb: WARNING: could not fetch mpegts.js 1.8.0; run install.sh again when the router has Internet access." >&2
fi
mkdir -p /tmp
exit 0
# rev4.19: Fetch the local mpg123-decoder WASM bundle. Runtime playback is
# local and does not contact a CDN.
MPG_TARGET=/www/luci-static/resources/iptvweb/mpg123-decoder.min.js
MPG_TMP=/tmp/mpg123-decoder.min.js.iptvweb
MPG_URL1='https://cdn.jsdelivr.net/npm/mpg123-decoder@1.0.3/dist/mpg123-decoder.min.js'
MPG_URL2='https://unpkg.com/mpg123-decoder@1.0.3/dist/mpg123-decoder.min.js'
mpg_fetch_ok=0
if command -v uclient-fetch >/dev/null 2>&1; then
    uclient-fetch -q -O "$MPG_TMP" "$MPG_URL1" 2>/dev/null && mpg_fetch_ok=1 || true
    if [ "$mpg_fetch_ok" = 0 ]; then
        uclient-fetch -q -O "$MPG_TMP" "$MPG_URL2" 2>/dev/null && mpg_fetch_ok=1 || true
    fi
elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$MPG_TMP" "$MPG_URL1" && mpg_fetch_ok=1 || true
    if [ "$mpg_fetch_ok" = 0 ]; then
        wget -q -O "$MPG_TMP" "$MPG_URL2" && mpg_fetch_ok=1 || true
    fi
fi
if [ "$mpg_fetch_ok" = 1 ] && [ -s "$MPG_TMP" ] && [ "$(wc -c < "$MPG_TMP")" -gt 50000 ] && grep -q 'MPEGDecoder' "$MPG_TMP" 2>/dev/null; then
    mv -f "$MPG_TMP" "$MPG_TARGET"
    chmod 0644 "$MPG_TARGET"
else
    rm -f "$MPG_TMP"
    echo "iptvweb: WARNING: could not fetch mpg123-decoder 1.0.3; run install.sh again when the router has Internet access." >&2
fi
