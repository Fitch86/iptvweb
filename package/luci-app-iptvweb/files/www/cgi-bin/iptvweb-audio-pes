#!/usr/bin/lua
-- rev4.26: strict MP2 frame validation, signature locking

local function qget(name)
  local q=os.getenv('QUERY_STRING') or ''
  for part in q:gmatch('[^&]+') do
    local k,v=part:match('^([^=]*)=(.*)$')
    if k==name then
      v=(v or ''):gsub('+',' '):gsub('%%(%x%x)', function(h) return string.char(tonumber(h,16)) end)
      return v
    end
  end
end
local group=qget('group') or ''
local port=qget('port') or ''
local a,b,c,d=group:match('^(%d+)%.(%d+)%.(%d+)%.(%d+)$')
a,b,c,d=tonumber(a),tonumber(b),tonumber(c),tonumber(d)
local pton=tonumber(port)
if not (a and b and c and d and a>=224 and a<=239 and b<=255 and c<=255 and d<=255 and pton and pton>=1 and pton<=65535) then os.exit(1) end

local udpxy
local f=io.popen("uci -q get iptvweb.main.udpxy 2>/dev/null",'r')
if f then udpxy=f:read('*l'); f:close() end
if not udpxy or not udpxy:match('^[%w%.%-]+:%d+$') then os.exit(1) end

local pipe=io.popen("uclient-fetch -q -O - 'http://"..udpxy.."/udp/"..group..":"..port.."' 2>/dev/null",'r')
if not pipe then os.exit(1) end
pcall(function() io.stdout:setvbuf('no') end)

io.write('Content-Type: application/octet-stream\r\n')
io.write('Cache-Control: no-store, no-cache, must-revalidate\r\n')
io.write('Pragma: no-cache\r\n')
io.write('X-Content-Type-Options: nosniff\r\n')
io.write('Connection: close\r\n\r\n')
io.flush()

local tsbuf=''
local pmt_pid=nil
local audio_pid=nil
local pesbuf=''
local outbuf=''
local frames=0
local frames_since_flush=0
local first_sig=nil

local function u8(s,i) return s:byte(i) end
local function band(a,b)
  local r,bit=0,1
  while a>0 and b>0 do
    if (a%2)==1 and (b%2)==1 then r=r+bit end
    a=math.floor(a/2); b=math.floor(b/2); bit=bit*2
  end
  return r
end
local function rshift(a,n) return math.floor(a/(2^n)) end
local function be16(s,i) return u8(s,i)*256+u8(s,i+1) end

local function parse_pat(payload,pusi)
  if not pusi or #payload<2 then return end
  local ptr=u8(payload,1) or 0
  local i=2+ptr
  if i+7>#payload or u8(payload,i)~=0 then return end
  local sec=(band(u8(payload,i+1),15)*256)+u8(payload,i+2)
  local e=math.min(#payload,i+3+sec-4)
  i=i+8
  while i+3<=e do
    local pn=be16(payload,i)
    local pid=(band(u8(payload,i+2),31)*256)+u8(payload,i+3)
    if pn~=0 then pmt_pid=pid; return end
    i=i+4
  end
end

local function parse_pmt(payload,pusi)
  if not pusi or #payload<3 then return end
  local ptr=u8(payload,1) or 0
  local i=2+ptr
  if i+11>#payload or u8(payload,i)~=2 then return end
  local sec=(band(u8(payload,i+1),15)*256)+u8(payload,i+2)
  local e=math.min(#payload,i+3+sec-4)
  local pil=(band(u8(payload,i+10),15)*256)+u8(payload,i+11)
  i=i+12+pil
  while i+4<=e do
    local st=u8(payload,i)
    local pid=(band(u8(payload,i+1),31)*256)+u8(payload,i+2)
    local eil=(band(u8(payload,i+3),15)*256)+u8(payload,i+4)
    if i+5+eil>e then break end
    if st==3 or st==4 then audio_pid=pid; return end
    i=i+5+eil
  end
end

local function pes_payload(data)
  if #data<9 or data:sub(1,3)~='\0\0\1' then return '' end
  local hlen=u8(data,9) or 0
  local start=10+hlen
  if start>#data then return '' end
  return data:sub(start)
end

local function header(s,i)
  if i+3>#s then return nil end
  local x1,x2,x3,x4=s:byte(i,i+3)
  if x1~=0xff or band(x2,0xe0)~=0xe0 then return nil end
  local vi=band(rshift(x2,3),3)
  local li=band(rshift(x2,1),3)
  local bi=band(rshift(x3,4),15)
  local si=band(rshift(x3,2),3)
  if vi==1 or li==0 or bi==0 or bi==15 or si==3 then return nil end
  local srates={ [3]={44100,48000,32000}, [2]={22050,24000,16000}, [0]={11025,12000,8000} }
  local sr=srates[vi] and srates[vi][si+1]
  if not sr then return nil end
  local mpeg1_l1={0,32,64,96,128,160,192,224,256,288,320,352,384,416,448}
  local mpeg1_l23={0,32,48,56,64,80,96,112,128,160,192,224,256,320,384}
  local mpeg2_l1={0,32,48,56,64,80,96,112,128,144,160,176,192,224,256}
  local mpeg2_l23={0,8,16,24,32,40,48,56,64,80,96,112,128,144,160}
  local tbl
  if vi==3 then
    tbl=(li==3) and mpeg1_l1 or mpeg1_l23
  else
    tbl=(li==3) and mpeg2_l1 or mpeg2_l23
  end
  local kbps=tbl[bi+1]
  if not kbps or kbps==0 then return nil end
  local pad=band(rshift(x3,1),1)
  local len
  if li==3 then
    len=math.floor((12*kbps*1000/sr)+pad)*4
  elseif vi==3 then
    len=math.floor((144*kbps*1000/sr)+pad)
  else
    len=math.floor((72*kbps*1000/sr)+pad)
  end
  if len<4 or len>4096 then return nil end
  local sig = vi..':'..li..':'..kbps..':'..sr
  if first_sig ~= nil and sig ~= first_sig then return nil end
  return { len=len, sig=sig }
end

local function next_header(s,start)
  local p=start
  while true do
    local cur=s:find(string.char(0xff),p,true)
    if not cur then return nil end
    local h=header(s,cur)
    if h then return cur,h end
    p=cur+1
  end
end

local function emit_ready_frames(force)
  while #pesbuf >= 4 do
    local pos, h = next_header(pesbuf, 1)
    if not pos then
      if #pesbuf > 8192 then pesbuf = pesbuf:sub(-4096) end
      break
    end
    if pos > 1 then pesbuf = pesbuf:sub(pos) end
    
    -- 数据不足一帧，等
    if #pesbuf < h.len then break end
    
    local verified = false
    
    if #pesbuf >= h.len + 4 then
      -- 严格模式：校验下一帧
      local next_h = header(pesbuf, h.len + 1)
      if next_h and next_h.sig == h.sig then
        verified = true
      else
        -- 校验失败：真假帧头，丢 1 字节重找
        pesbuf = pesbuf:sub(2)
      end
    else
      -- 数据不够校验
      if first_sig and h.sig == first_sig then
        -- 已经锁定过参数，这一帧和已知参数一致，相信它
        verified = true
      else
        -- 还没锁定，严格等待
        break
      end
    end
    
    if verified then
      if first_sig == nil then first_sig = h.sig end
      outbuf = outbuf .. pesbuf:sub(1, h.len)
      pesbuf = pesbuf:sub(h.len + 1)
      frames = frames + 1
      frames_since_flush = frames_since_flush + 1
      if #outbuf >= 4096 or frames_since_flush >= 8 then
        io.write(outbuf); io.flush()
        outbuf = ''; frames_since_flush = 0
      end
    end
  end
  if force and #outbuf > 0 then
    io.write(outbuf); io.flush()
    outbuf = ''; frames_since_flush = 0
  end
end

local function process(pkt)
  if #pkt~=188 or u8(pkt,1)~=0x47 then return end
  local pusi=band(u8(pkt,2),64)~=0
  local pid=(band(u8(pkt,2),31)*256)+u8(pkt,3)
  local afc=band(u8(pkt,4),48)/16
  local pos=5
  if afc==2 or afc==3 then pos=6+(u8(pkt,5) or 0) end
  if afc==0 or afc==2 or pos>188 then return end
  local payload=pkt:sub(pos)
  if pid==0 then parse_pat(payload,pusi); return end
  if pmt_pid and pid==pmt_pid then parse_pmt(payload,pusi); return end
  if not audio_pid or pid~=audio_pid then return end
  
  if pusi then
    -- PUSI：剥离 PES header 后追加（不清空残留）
    local cur = pes_payload(payload)
    if #cur > 0 then
      pesbuf = pesbuf .. cur
    end
  else
    pesbuf = pesbuf .. payload
  end
  emit_ready_frames(false)
end

while true do
  local chunk=pipe:read(4096)
  if not chunk or #chunk==0 then break end
  tsbuf=tsbuf..chunk
  while #tsbuf>=188 do
    if tsbuf:byte(1)~=0x47 then
      local n=tsbuf:find(string.char(0x47),2,true)
      if not n then tsbuf=tsbuf:sub(-187); break end
      tsbuf=tsbuf:sub(n)
      if #tsbuf<188 then break end
    end
    local pkt=tsbuf:sub(1,188)
    tsbuf=tsbuf:sub(189)
    process(pkt)
  end
end

emit_ready_frames(true)
pipe:close()