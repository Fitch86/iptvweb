#!/bin/sh
# Same-origin long-lived MPEG-TS proxy for udpxy.
# Keep the browser HTTP response alive across udpxy upstream disconnects.
# Exit promptly if the client is gone so script_timeout=86400 cannot leak CGIs.

printf 'Content-Type: video/mp2t\r\nCache-Control: no-store, no-cache, must-revalidate\r\nPragma: no-cache\r\nX-Content-Type-Options: nosniff\r\nAccess-Control-Allow-Origin: *\r\nConnection: keep-alive\r\n\r\n'

qs="${QUERY_STRING:-}"
group="$(printf '%s' "$qs" | tr '&' '\n' | sed -n 's/^group=//p' | head -n1)"
port="$(printf '%s' "$qs" | tr '&' '\n' | sed -n 's/^port=//p' | head -n1)"

group="$(printf '%s' "$group" | sed 's/+/ /g; s/%/\\x/g' | xargs printf '%b' 2>/dev/null || true)"
udpxy="$(uci -q get iptvweb.main.udpxy 2>/dev/null || true)"
[ -n "$udpxy" ] || exit 1
case "$udpxy" in *[!A-Za-z0-9.:-]*) exit 1;; esac

oldIFS="$IFS"; IFS=.; set -- $group; IFS="$oldIFS"
[ "$#" = 4 ] || exit 1
for octet in "$@"; do
    case "$octet" in ''|*[!0-9]*) exit 1;; esac
    [ "$octet" -le 255 ] 2>/dev/null || exit 1
done
first="$1"
[ "$first" -ge 224 ] 2>/dev/null || exit 1
[ "$first" -le 239 ] 2>/dev/null || exit 1
case "$port" in ''|*[!0-9]*) exit 1;; esac
[ "$port" -ge 1 ] 2>/dev/null || exit 1
[ "$port" -le 65535 ] 2>/dev/null || exit 1

url="http://${udpxy}/udp/${group}:${port}"

trap 'exit 0' PIPE HUP TERM INT

fetch_once() {
    if command -v uclient-fetch >/dev/null 2>&1; then
        uclient-fetch -q -O - "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O - "$url"
    else
        return 127
    fi
}

# Reconnect udpxy blips, but do not spin until script_timeout if the browser
# already closed the pipe (writes then fail immediately with EPIPE).
fails=0
while :; do
    if fetch_once 2>/dev/null; then
        fails=0
    else
        fails=$((fails + 1))
        [ "$fails" -ge 40 ] && exit 0
        sleep 0.2 2>/dev/null || sleep 1
    fi
done
