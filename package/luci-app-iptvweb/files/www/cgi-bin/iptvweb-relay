#!/usr/bin/lua
-- Same-origin, streaming bridge to the existing iptv-relay on 127.0.0.1:4023.
-- This CGI does not modify or restart the relay service.
local function qget(name)
  local q=os.getenv('QUERY_STRING') or ''
  for part in q:gmatch('[^&]+') do
    local k,v=part:match('^([^=]*)=(.*)$')
    if k==name then
      v=(v or ''):gsub('+',' '):gsub('%%(%x%x)',function(h) return string.char(tonumber(h,16)) end)
      return v
    end
  end
  return nil
end
local function bad(msg,code)
  io.write('Status: '..(code or '400 Bad Request')..'\r\nContent-Type: text/plain; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'..msg..'\n')
  io.flush()
  os.exit(0)
end
local function pct(s)
  return (s:gsub('([^A-Za-z0-9%-_%.~])',function(c) return string.format('%%%02X',c:byte()) end))
end
local function shellquote(s)
  return "'"..s:gsub("'","'\\''").."'"
end
local rtsp=qget('url') or ''
local seek=qget('seek') or ''
if #rtsp<12 or #rtsp>2048 or rtsp:find('[%c%s]') or not rtsp:match('^rtsp://') then
  bad('Invalid RTSP URL')
end
local authority=rtsp:match('^rtsp://([^/]+)')
if not authority or authority:find('@',1,true) or not authority:match('^[%w%.%-]+:?%d*$') then
  bad('Invalid RTSP host')
end
local host=authority:match('^([%w%.%-]+)')
if not host or #host>253 or host:match('^%.') or host:match('%.$') or host:find('%.%.',1,true) then
  bad('Invalid RTSP host')
end
if seek~='' then
  local a,b=seek:match('^(%d%d%d%d%d%d%d%d%d%d%d%d%d%d)%-(%d%d%d%d%d%d%d%d%d%d%d%d%d%d)$')
  if not a then bad('Invalid seek range') end
  local function stamp(s)
    local y,mo,d,h,mi,se=tonumber(s:sub(1,4)),tonumber(s:sub(5,6)),tonumber(s:sub(7,8)),tonumber(s:sub(9,10)),tonumber(s:sub(11,12)),tonumber(s:sub(13,14))
    if mo<1 or mo>12 or d<1 or d>31 or h>23 or mi>59 or se>59 then return nil end
    return os.time({year=y,month=mo,day=d,hour=h,min=mi,sec=se,isdst=false})
  end
  local ta,tb=stamp(a),stamp(b)
  if not ta or not tb or tb<=ta or tb-ta>14400 then bad('Seek range must be between 1 second and 4 hours') end
end
local upstream='http://127.0.0.1:4023/stream?url='..pct(rtsp)
if seek~='' then upstream=upstream..'&seek='..seek end
local cmd='uclient-fetch -q -O - '..shellquote(upstream)..' 2>/dev/null'
local pipe=io.popen(cmd,'r')
if not pipe then bad('Unable to start upstream fetch','502 Bad Gateway') end
pcall(function() io.stdout:setvbuf('no') end)
io.write('Content-Type: video/mp2t\r\nCache-Control: no-store, no-cache, must-revalidate\r\nPragma: no-cache\r\nX-Content-Type-Options: nosniff\r\nConnection: close\r\n\r\n')
io.flush()
while true do
  local chunk=pipe:read(4096)
  if not chunk or #chunk==0 then break end
  local ok=pcall(function() io.stdout:write(chunk); io.stdout:flush() end)
  if not ok then break end
end
pcall(function() pipe:close() end)
