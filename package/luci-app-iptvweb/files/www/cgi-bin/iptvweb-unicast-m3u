#!/bin/sh
# Independent unicast M3U endpoint. Cached separately from multicast.
set -u
cache="$(uci -q get iptvweb.main.unicast_m3u_cache 2>/dev/null || echo /tmp/iptvweb-unicast.m3u)"
url="$(uci -q get iptvweb.main.unicast_m3u_url 2>/dev/null || echo https://myepg.org/api/subscribe/unicast/m3u)"
ttl="$(uci -q get iptvweb.main.unicast_m3u_cache_ttl 2>/dev/null || echo 21600)"
case "$ttl" in ''|*[!0-9]*) ttl=21600;; esac
case "$url" in
    https://*) ;;
    *) printf 'Status: 502 Bad Gateway\r\nContent-Type: text/plain; charset=utf-8\r\nCache-Control: no-store\r\n\r\nInvalid unicast M3U URL (HTTPS required).\n'; exit 0 ;;
esac
now="$(date +%s)"
mtime=0
[ -f "$cache" ] && mtime="$(stat -c %Y "$cache" 2>/dev/null || echo 0)"
case "$mtime" in ''|*[!0-9]*) mtime=0;; esac
force=0
case "&${QUERY_STRING:-}&" in *"&refresh=1&"*) force=1;; esac
if [ ! -s "$cache" ] || [ "$force" -eq 1 ] || [ $((now - mtime)) -ge "$ttl" ]; then
    tmp="${cache}.tmp.$$"
    rm -f "$tmp"
    if command -v uclient-fetch >/dev/null 2>&1; then
        uclient-fetch -q -T 20 -O "$tmp" "$url" >/dev/null 2>&1 || rm -f "$tmp"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -T 20 -O "$tmp" "$url" >/dev/null 2>&1 || rm -f "$tmp"
    else
        rm -f "$tmp"
    fi
    if [ -s "$tmp" ] && grep -q '^#EXTM3U' "$tmp"; then
        mv -f "$tmp" "$cache"
    else
        rm -f "$tmp"
    fi
fi
printf 'Content-Type: audio/x-mpegurl\r\nCache-Control: no-cache\r\n\r\n'
if [ -s "$cache" ]; then
    cat "$cache"
else
    printf '#EXTM3U\r\n# IPTV Web: unable to fetch unicast M3U. Check unicast_m3u_url and router connectivity.\r\n'
fi
