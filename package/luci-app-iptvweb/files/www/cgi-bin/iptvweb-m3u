#!/bin/sh
# CGI endpoint: returns the cached M3U, refreshing it when stale.
printf 'Content-Type: audio/x-mpegurl\r\nCache-Control: no-cache\r\n\r\n'

cache="$(uci -q get iptvweb.main.cache 2>/dev/null || echo /tmp/iptvweb.m3u)"
ttl="$(uci -q get iptvweb.main.cache_ttl 2>/dev/null || echo 21600)"
now="$(date +%s)"
mtime=0

[ -f "$cache" ] && mtime="$(stat -c %Y "$cache" 2>/dev/null || echo 0)"

if [ ! -s "$cache" ] || [ $((now - mtime)) -ge "$ttl" ]; then
    /usr/bin/iptvweb-fetch "$cache" >/dev/null 2>&1 || true
fi

if [ -s "$cache" ]; then
    cat "$cache"
else
    printf '#EXTM3U\r\n# IPTV Web: unable to fetch M3U\r\n'
fi
