#!/usr/bin/lua
-- rev4.16.3: MPEG Audio frame-header probe.
-- Returns JSON describing the first MPEG Audio frame found in the IPTV TS.

local function qget(name)
  local q=os.getenv('QUERY_STRING') or ''
  for part in q:gmatch('[^&]+') do
    local k,v=part:match('^([^=]*)=(.*)$')
    if k==name then
      v=(v or ''):gsub('+',' '):gsub('%%(%x%x)', function(h) return string.char(tonumber(h,16)) end)
      return v
    end
  end
end
local group=qget('group') or ''
local port=qget('port') or ''
local a,b,c,d=group:match('^(%d+)%.(%d+)%.(%d+)%.(%d+)$')
a,b,c,d=tonumber(a),tonumber(b),tonumber(c),tonumber(d)
local p=tonumber(port)
if not (a and b and c and d and a>=224 and a<=239 and b<=255 and c<=255 and d<=255 and p and p>=1 and p<=65535) then
  print('Content-Type: application/json\r\n\r\n{"ok":false,"error":"bad parameters"}')
  os.exit(0)
end
local udpxy
local f=io.popen("uci -q get iptvweb.main.udpxy 2>/dev/null", 'r')
if f then udpxy=f:read('*l'); f:close() end
if not udpxy or not udpxy:match('^[%w%.%-]+:%d+$') then
  print('Content-Type: application/json\r\n\r\n{"ok":false,"error":"udpxy not configured"}')
  os.exit(0)
end
local pipe=io.popen("uclient-fetch -q -O - 'http://"..udpxy.."/udp/"..group..":"..port.."' 2>/dev/null", 'r')
if not pipe then
  print('Content-Type: application/json\r\n\r\n{"ok":false,"error":"fetch failed"}')
  os.exit(0)
end
local buf=''; local pmt_pid=nil; local audio_pid=nil
local function u8(s,i) return s:byte(i) end
local function be16(s,i) return u8(s,i)*256+u8(s,i+1) end
local function pat(payload,pusi)
  if not pusi or #payload<8 then return end
  local ptr=u8(payload,1) or 0; local i=2+ptr
  if i+7>#payload or u8(payload,i)~=0 then return end
  local sec=((u8(payload,i+1)&15)*256)+u8(payload,i+2)
  local e=math.min(#payload,i+3+sec-4); i=i+8
  while i+3<=e do
    local pn=be16(payload,i); local pid=((u8(payload,i+2)&31)*256)+u8(payload,i+3)
    if pn~=0 then pmt_pid=pid; return end
    i=i+4
  end
end
local function pmt(payload,pusi)
  if not pusi or #payload<12 then return end
  local ptr=u8(payload,1) or 0; local i=2+ptr
  if i+11>#payload or u8(payload,i)~=2 then return end
  local sec=((u8(payload,i+1)&15)*256)+u8(payload,i+2)
  local e=math.min(#payload,i+3+sec-4)
  local pil=((u8(payload,i+10)&15)*256)+u8(payload,i+11)
  i=i+12+pil
  while i+4<=e do
    local st=u8(payload,i); local pid=((u8(payload,i+1)&31)*256)+u8(payload,i+2)
    local eil=((u8(payload,i+3)&15)*256)+u8(payload,i+4)
    if i+5+eil>e then break end
    if st==3 or st==4 then audio_pid=pid; return end
    i=i+5+eil
  end
end
local function jsonstr(s)
  s=tostring(s or ''):gsub('\\','\\\\'):gsub('"','\\"'):gsub('\r','\\r'):gsub('\n','\\n')
  return '"'..s..'"'
end
local function probe(h)
  if #h<4 then return nil end
  local x1,x2,x3,x4=h:byte(1,4)
  if x1~=0xff or (x2&0xe0)~=0xe0 then return nil end
  local vi=(x2>>3)&3; local li=(x2>>1)&3; local bi=(x3>>4)&15; local si=(x3>>2)&3
  local version={[3]='MPEG-1',[2]='MPEG-2',[0]='MPEG-2.5'}[vi] or 'reserved'
  local layer={[3]='Layer I',[2]='Layer II',[1]='Layer III'}[li] or 'reserved'
  if vi==1 or li==0 or bi==15 or bi==0 or si==3 then return nil end
  local srates={ [3]={44100,48000,32000}, [2]={22050,24000,16000}, [0]={11025,12000,8000} }
  local sr=srates[vi] and srates[vi][si]
  local br1={0,32,40,48,56,64,80,96,112,128,160,192,224,256,320}
  local br2={0,8,16,24,32,40,48,56,64,80,96,112,128,144,160}
  local kbps
  if vi==3 then kbps=(li==3 and br1[bi+1] or br1[bi+1]) else kbps=br2[bi+1] end
  if not kbps or kbps==0 then return nil end
  local chmode=(x4>>6)&3
  local channels=(chmode==3) and 1 or 2
  local padding=(x3>>1)&1
  local samples=(li==3) and 384 or (vi==3 and 1152 or 576)
  local frame_len
  if li==3 then frame_len=math.floor((12*kbps*1000/sr)+padding)*4
  elseif vi==3 then frame_len=math.floor((144*kbps*1000/sr)+padding)
  else frame_len=math.floor((72*kbps*1000/sr)+padding) end
  return {version=version,layer=layer,bitrate_kbps=kbps,sample_rate=sr,channels=channels,channel_mode=chmode,frame_length=frame_len,hex=string.format('%02X %02X %02X %02X',x1,x2,x3,x4)}
end
local function esc(v) return jsonstr(v) end
local result=nil
while not result do
  local chunk=pipe:read(65536); if not chunk or #chunk==0 then break end
  buf=buf..chunk
  while #buf>=188 and not result do
    if u8(buf,1)~=0x47 then
      local found=buf:find('\x47',2,true); if not found then buf=buf:sub(-187); break end; buf=buf:sub(found)
      if #buf<188 then break end
    end
    local pkt=buf:sub(1,188); buf=buf:sub(189)
    local pusi=(u8(pkt,2)&0x40)~=0; local pid=((u8(pkt,2)&31)*256)+u8(pkt,3)
    local afc=(u8(pkt,4)&0x30)/16; local pos=5
    if afc==2 or afc==3 then pos=6+(u8(pkt,5) or 0) end
    if afc~=0 and afc~=2 and pos<=188 then
      local payload=pkt:sub(pos)
      if pid==0 then pat(payload,pusi)
      elseif pmt_pid and pid==pmt_pid then pmt(payload,pusi)
      elseif audio_pid and pid==audio_pid and pusi and #payload>=12 then
        local hlen=u8(payload,9) or 0; local start=10+hlen
        if start<=#payload then
          local data=payload:sub(start)
          for i=1,math.min(#data-3,4096) do
            local q=probe(data:sub(i)); if q then q.pid=audio_pid; q.pmt_stream_type=3; q.offset_in_pes_payload=i-1; result=q; break end
          end
        end
      end
    end
  end
end
pipe:close()
print('Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n')
if result then
  print(string.format('{"ok":true,"pid":%d,"pmt_stream_type":%d,"version":%s,"layer":%s,"bitrate_kbps":%d,"sample_rate":%d,"channels":%d,"frame_length":%d,"header_hex":%s,"offset_in_pes_payload":%d}', result.pid,result.pmt_stream_type,esc(result.version),esc(result.layer),result.bitrate_kbps,result.sample_rate,result.channels,result.frame_length,esc(result.hex),result.offset_in_pes_payload))
else
  print('{"ok":false,"error":"MPEG Audio frame header not found"}')
end
