local function u8(s,i) return s:byte(i) end
-- OpenWrt's /usr/bin/lua may be Lua 5.1; avoid Lua 5.3 bitwise operators.
local function band(a,b)
  local r,bit=0,1
  while a>0 and b>0 do
    if (a%2)==1 and (b%2)==1 then r=r+bit end
    a=math.floor(a/2); b=math.floor(b/2); bit=bit*2
  end
  return r
end
local function rshift(a,n) return math.floor(a/(2^n)) end
local function be16(s,i) return u8(s,i)*256+u8(s,i+1) end
local function pat(payload,pusi)
  if not pusi or #payload<8 then return end
  local ptr=u8(payload,1) or 0; local i=2+ptr
  if i+7>#payload or u8(payload,i)~=0 then return end
--  local sec=(band(u8(payload,i+1),15)*256)+u8(payload,i+2)
--  local e=math.min(#payload,i+3+sec-4); i=i+8
--  while i+3<=e do
--    local pn=be16(payload,i); local pid=(band(u8(payload,i+2),31)*256)+u8(payload,i+3)
--    if pn~=0 then pmt_pid=pid; return end
--    i=i+4
--  end
  local sec=(band(u8(payload,i+1),15)*256)+u8(payload,i+2)
  local section_end=i+2+sec
  if section_end>#payload then return end
  local entries_end=section_end-4
  i=i+8
  while i+3<=entries_end do
    local pn=be16(payload,i)
    local pid=band(u8(payload,i+2),31)*256+u8(payload,i+3)
    if pn~=0 then pmt_pid=pid; return end
    i=i+4
  end
end
