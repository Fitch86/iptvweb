local function pmt(payload,pusi)
  if not pusi or #payload<12 then return end
  local ptr=u8(payload,1) or 0
  local i=2+ptr
  if i+11>#payload or u8(payload,i)~=2 then return end
  local sec=(band(u8(payload,i+1),15)*256)+u8(payload,i+2)
  local section_end=i+2+sec
  if section_end>#payload then return end
  -- PMT 的最后 4 字节是 CRC；ES entries 在 CRC 之前
  local entries_end=section_end-4
  local pil=(band(u8(payload,i+10),15)*256)+u8(payload,i+11)
  local pos=i+12+pil
  if pos>entries_end+1 then return end
  local mpeg=nil
  local aac=nil
  local video=nil
  while pos+4<=entries_end do
    local st=u8(payload,pos)
    local pid=(band(u8(payload,pos+1),31)*256)+u8(payload,pos+2)
    local eil=(band(u8(payload,pos+3),15)*256)+u8(payload,pos+4)
    if pos+4+eil>entries_end then return end
    local item={pid=pid,st=st}
    if st==3 then
      item.codec='MPEG-1 Audio'
      mpeg=mpeg or item
    elseif st==4 then
      item.codec='MPEG-2 Audio'
      mpeg=mpeg or item
    elseif st==15 then
      item.codec='AAC-ADTS'
      aac=aac or item
    elseif st==17 then
      item.codec='AAC-LATM'
      aac=aac or item
    elseif st==1 or st==2 or st==16 or st==27 or st==36 or st==66 then
      -- MPEG-1/2, MPEG-4, AVC/H.264, HEVC/H.265, AVS video ES.
      video=video or item
    end
    pos=pos+5+eil
  end
  -- 如果 PMT 同时列出 AAC 和 MPEG 音轨，保守选择 A/V MSE，
  -- 避免 video-only 路径把 AAC 音轨删掉。
  local selected=aac or mpeg
  if selected then
    result={pid=selected.pid,st=selected.st,codec=selected.codec,video=video}
  else
    -- PMT 已解析，但没有识别出上述音频类型；前端应默认 A/V。
    result={pid=nil,st=nil,codec='unknown',video=video}
  end
end
local function jsonstr(s)
  s=tostring(s or ''):gsub('\\','\\\\'):gsub('"','\\"'):gsub('\r','\\r'):gsub('\n','\\n')
  return '"'..s..'"'
end
local function probe(h)
  if #h<4 then return nil end
  local x1,x2,x3,x4=h:byte(1,4)
  if x1~=0xff or band(x2,0xe0)~=0xe0 then return nil end
  local vi=band(rshift(x2,3),3); local li=band(rshift(x2,1),3); local bi=band(rshift(x3,4),15); local si=band(rshift(x3,2),3)
  local version_map={[3]='MPEG-1',[2]='MPEG-2',[0]='MPEG-2.5'}
  local layer_map={[3]='Layer I',[2]='Layer II',[1]='Layer III'}
  local version=version_map[vi] or 'reserved'
  local layer=layer_map[li] or 'reserved'
  if vi==1 or li==0 or bi==15 or bi==0 or si==3 then return nil end
  local srates={ [3]={44100,48000,32000}, [2]={22050,24000,16000}, [0]={11025,12000,8000} }
  local sr=srates[vi] and srates[vi][si]
  local br1={0,32,40,48,56,64,80,96,112,128,160,192,224,256,320}
  local br2={0,8,16,24,32,40,48,56,64,80,96,112,128,144,160}
  local kbps
  if vi==3 then kbps=(li==3 and br1[bi+1] or br1[bi+1]) else kbps=br2[bi+1] end
  if not kbps or kbps==0 then return nil end
  local chmode=band(rshift(x4,6),3)
  local channels=(chmode==3) and 1 or 2
  local padding=band(rshift(x3,1),1)
  local samples=(li==3) and 384 or (vi==3 and 1152 or 576)
  local frame_len
  if li==3 then frame_len=math.floor((12*kbps*1000/sr)+padding)*4
  elseif vi==3 then frame_len=math.floor((144*kbps*1000/sr)+padding)
  else frame_len=math.floor((72*kbps*1000/sr)+padding) end
  return {version=version,layer=layer,bitrate_kbps=kbps,sample_rate=sr,channels=channels,channel_mode=chmode,frame_length=frame_len,hex=string.format('%02X %02X %02X %02X',x1,x2,x3,x4)}
end
