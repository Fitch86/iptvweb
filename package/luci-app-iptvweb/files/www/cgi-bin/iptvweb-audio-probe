while not result and total_read < 1024*1024 do
  local chunk=pipe:read(65536)
  if not chunk or #chunk==0 then break end

  total_read=total_read+#chunk
  buf=buf..chunk

  while #buf>=188 and not result do
    -- MPEG-TS 同步
    if u8(buf,1)~=0x47 then
      local found=buf:find(string.char(0x47),2,true)
      if not found then
        buf=buf:sub(-187)
        break
      end
      buf=buf:sub(found)
      if #buf<188 then break end
    end

    local pkt=buf:sub(1,188)
    buf=buf:sub(189)

    local pusi=band(u8(pkt,2),0x40)~=0
    local pid=band(u8(pkt,2),31)*256+u8(pkt,3)
    local afc=band(u8(pkt,4),0x30)/16

    local pos=5
    if afc==2 or afc==3 then
      pos=6+(u8(pkt,5) or 0)
    end

    -- afc=1：只有 payload；afc=3：adaptation field 后有 payload
    if (afc==1 or afc==3) and pos<=188 then
      local payload=pkt:sub(pos)

      if pid==0 then
        pat(payload,pusi)
      elseif pmt_pid and pid==pmt_pid then
        pmt(payload,pusi)
      end
    end
  end
end
