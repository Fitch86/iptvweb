#!/bin/sh /etc/rc.common
# /etc/init.d/iptv-relay  — IPTV 回看中继常驻
START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/bin/iptv_relay.py --daemon 0.0.0.0 4023
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
